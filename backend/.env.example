# Copy to .env for running the API directly with `npm run dev`.
# (docker compose sets its own values; nothing in the code reads .env automatically,
#  export these or use `node --env-file=.env src/server.js` on Node 20.6+.)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mern_cicd
APP_VERSION=dev
